{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Windows 95/98 desktop chrome — a single grey plastic face, hard two-tone 3D bevels, one navy gradient title bar.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0.502
        ],
        "hex": "#000080"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0.627
        ],
        "hex": "#0000a0"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.502,
          0.502
        ],
        "hex": "#008080"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.31,
          0.627
        ],
        "hex": "#0a4fa0"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.753,
          0.753,
          0.753
        ],
        "hex": "#c0c0c0"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.831,
          0.816,
          0.784
        ],
        "hex": "#d4d0c8"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          0.2,
          0.2
        ],
        "hex": "#333333"
      }
    },
    "text-dim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.227,
          0.227,
          0.227
        ],
        "hex": "#3a3a3a"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.502,
          0.502,
          0.502
        ],
        "hex": "#808080"
      }
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.502,
          0
        ],
        "hex": "#008000"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.42,
          0.42,
          0
        ],
        "hex": "#6b6b00"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.502,
          0,
          0
        ],
        "hex": "#800000"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11,
          0.373,
          0.69
        ],
        "hex": "#1c5fb0"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Silkscreen",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Silkscreen",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Public Sans",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "VT323",
        "fontSize": {
          "value": 0.9,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "VT323",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
