  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 0.35,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.6,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Oxanium",
        "fontSize": {
          "value": 2.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Oxanium",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 650
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.18,
          "unit": "em"
        }
