{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The pilot's instrument panel — amber readouts, a targeting reticle, a range scale and hazard tape on gunmetal, with no smooth edge anywhere.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.671,
          0.169
        ],
        "hex": "#ffab2b"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.737,
          0.302
        ],
        "hex": "#ffbc4d"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.753,
          0.38
        ],
        "hex": "#ffc061"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.247,
          0.816,
          0.902
        ],
        "hex": "#3fd0e6"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.824,
          0.29
        ],
        "hex": "#ffd24a"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.067,
          0.086
        ],
        "hex": "#0d1116"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.114,
          0.141
        ],
        "hex": "#171d24"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.09,
          0.125
        ],
        "hex": "#111720"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.933,
          0.961
        ],
        "hex": "#e8eef5"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.651,
          0.702
        ],
        "hex": "#9aa6b3"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.306,
          0.878,
          0.541
        ],
        "hex": "#4ee08a"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.353,
          0.302
        ],
        "hex": "#ff5a4d"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.006,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Saira",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Share Tech Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.16,
          "unit": "em"
        }
      }
    },
    "readout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.05,
          "unit": "em"
        }
      }
    }
  }
}
