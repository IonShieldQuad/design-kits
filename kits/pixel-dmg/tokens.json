{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The Game Boy DMG — a reflective monochrome LCD carrying four shades of green, dithered into a whole interface.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.22,
          0.059
        ],
        "hex": "#0f380f"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11,
          0.31,
          0.11
        ],
        "hex": "#1c4f1c"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.714,
          0.827,
          0.075
        ],
        "hex": "#b6d313"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.545,
          0.675,
          0.059
        ],
        "hex": "#8bac0f"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.188,
          0.384,
          0.188
        ],
        "hex": "#306230"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.608,
          0.737,
          0.059
        ],
        "hex": "#9bbc0f"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.706,
          0.824,
          0.071
        ],
        "hex": "#b4d212"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.608,
          0.737,
          0.059
        ],
        "hex": "#9bbc0f"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.031,
          0.149,
          0.031
        ],
        "hex": "#082608"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.22,
          0.059
        ],
        "hex": "#0f380f"
      }
    },
    "text-dim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.282,
          0.102
        ],
        "hex": "#1a481a"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.22,
          0.059
        ],
        "hex": "#0f380f"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.255,
          0.09
        ],
        "hex": "#174117"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.165,
          0.039
        ],
        "hex": "#0a2a0a"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11,
          0.29,
          0.11
        ],
        "hex": "#1c4a1c"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Press Start 2P",
        "fontSize": {
          "value": 2.4,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Silkscreen",
        "fontSize": {
          "value": 1.2,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Silkscreen",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "VT323",
        "fontSize": {
          "value": 1.05,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.1,
          "unit": "em"
        }
      }
    }
  }
}
