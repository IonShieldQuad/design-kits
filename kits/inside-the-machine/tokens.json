{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Machined instrumentation — a graphite chassis with engraved panels, drawn carbon-fibre cloth, a punched vent plate and brushed steel, opaque steel hairlines, amber for action, green phosphor for readouts, and IBM Plex Mono carrying the interface.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.69,
          0
        ],
        "hex": "#ffb000"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.761,
          0.2
        ],
        "hex": "#ffc233"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.059,
          0.067
        ],
        "hex": "#0d0f11"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.302,
          1,
          0.62
        ],
        "hex": "#4dff9e"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.424,
          0.6,
          0.722
        ],
        "hex": "#6c99b8"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.059,
          0.067
        ],
        "hex": "#0d0f11"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.098,
          0.114
        ],
        "hex": "#16191d"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.122,
          0.137
        ],
        "hex": "#1b1f23"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.914,
          0.929,
          0.937
        ],
        "hex": "#e9edef"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.604,
          0.643,
          0.678
        ],
        "hex": "#9aa4ad"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.302,
          1,
          0.62
        ],
        "hex": "#4dff9e"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.604,
          0.169
        ],
        "hex": "#d99a2b"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.318,
          0.278
        ],
        "hex": "#ff5147"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.005,
          "unit": "em"
        }
      }
    },
    "readout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.12,
          "unit": "em"
        }
      }
    }
  }
}
