{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Motorsport as broadcast — asphalt under kerbs and a chequered flag, set in a big italic.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.831,
          0.039,
          0
        ],
        "hex": "#d40a00"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.882,
          0.024,
          0
        ],
        "hex": "#e10600"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.478,
          0.427
        ],
        "hex": "#ff7a6d"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.914,
          0.933,
          0.953
        ],
        "hex": "#e9eef3"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.824,
          0.247
        ],
        "hex": "#ffd23f"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.059,
          0.071
        ],
        "hex": "#0d0f12"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.118,
          0.141
        ],
        "hex": "#1b1e24"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.149,
          0.165,
          0.192
        ],
        "hex": "#262a31"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.953,
          0.965,
          0.976
        ],
        "hex": "#f3f6f9"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.737,
          0.765,
          0.8
        ],
        "hex": "#bcc3cc"
      }
    },
    "text-invert": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.239,
          0.863,
          0.518
        ],
        "hex": "#3ddc84"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.384,
          0.337
        ],
        "hex": "#ff6256"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Saira",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Saira",
        "fontSize": {
          "value": 1.32,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.005,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.16,
          "unit": "em"
        }
      }
    },
    "timing": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.82,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    }
  }
}
