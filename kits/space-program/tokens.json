      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.914,
          0.933,
          0.961
        ],
        "hex": "#e9eef5"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.106,
