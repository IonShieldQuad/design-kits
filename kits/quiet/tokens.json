{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Quiet dark app chrome — one soft indigo accent, small radii, generous space, no decoration.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.357,
          0.486,
          0.98
        ],
        "hex": "#5b7cfa"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.451,
          0.565,
          1
        ],
        "hex": "#7390ff"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.055,
          0.075
        ],
        "hex": "#0b0e13"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.49,
          0.424,
          0.91
        ],
        "hex": "#7d6ce8"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.42,
          0.576,
          0.878
        ],
        "hex": "#6b93e0"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.055,
          0.075
        ],
        "hex": "#0b0e13"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.071,
          0.086,
          0.122
        ],
        "hex": "#12161f"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.11,
          0.153
        ],
        "hex": "#171c27"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.925,
          0.953
        ],
        "hex": "#e8ecf3"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.725,
          0.761,
          0.816
        ],
        "hex": "#b9c2d0"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.373,
          0.749,
          0.561
        ],
        "hex": "#5fbf8f"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.878,
          0.698,
          0.42
        ],
        "hex": "#e0b26b"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.514,
          0.514
        ],
        "hex": "#ff8383"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 2.6,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.78,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    },
    "data": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace, \"Cascadia Mono\", Consolas, monospace",
        "fontSize": {
          "value": 0.8,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
