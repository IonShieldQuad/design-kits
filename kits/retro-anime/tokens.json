{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "80s anime key art at dusk — indigo night, magenta neon, cyan tech, one striped sun.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.925,
          0.294,
          0.561
        ],
        "hex": "#ec4b8f"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.373,
          0.635
        ],
        "hex": "#ff5fa2"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.678,
          0.808
        ],
        "hex": "#ffadce"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.267,
          0.651,
          0.843
        ],
        "hex": "#44a6d7"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.71,
          0.482
        ],
        "hex": "#ffb57b"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.082,
          0.169
        ],
        "hex": "#19152b"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.133,
          0.102,
          0.227
        ],
        "hex": "#221a3a"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.067,
          0.161
        ],
        "hex": "#171129"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.925,
          1
        ],
        "hex": "#f7ecff"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.796,
          0.722,
          0.894
        ],
        "hex": "#cbb8e4"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.271,
          0.839,
          0.643
        ],
        "hex": "#45d6a4"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.769,
          0.42
        ],
        "hex": "#ffc46b"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.373,
          0.467
        ],
        "hex": "#ff5f77"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Audiowide",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Rajdhani",
        "fontSize": {
          "value": 1.32,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.005,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Rajdhani",
        "fontSize": {
          "value": 0.98,
          "unit": "rem"
        },
        "fontWeight": 500
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Share Tech Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.12,
          "unit": "em"
        }
      }
    },
    "tech": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Audiowide",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    }
  }
}
