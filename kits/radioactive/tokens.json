{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A containment site under CCTV — cold poured concrete, clinical white wall plates, hazard tape, and one toxic-green readout.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.525,
          0.784,
          0.102
        ],
        "hex": "#86c81a"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.471,
          0.722,
          0.078
        ],
        "hex": "#78b814"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.114,
          0.29,
          0.024
        ],
        "hex": "#1d4a06"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.525,
          0.047
        ],
        "hex": "#e8860c"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.259,
          0.494
        ],
        "hex": "#17427e"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.776,
          0.792,
          0.765
        ],
        "hex": "#c6cac3"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.957,
          0.937
        ],
        "hex": "#f2f4ef"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.749,
          0.765,
          0.737
        ],
        "hex": "#bfc3bc"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.071,
          0.082,
          0.059
        ],
        "hex": "#12150f"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.227,
          0.255,
          0.212
        ],
        "hex": "#3a4136"
      }
    },
    "text-dim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.259,
          0.29,
          0.247
        ],
        "hex": "#424a3f"
      }
    },
    "invert": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.075,
          0.051
        ],
        "hex": "#10130d"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.322,
          0.188
        ],
        "hex": "#0d5230"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.416,
          0.247,
          0.016
        ],
        "hex": "#6a3f04"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.086,
          0.051
        ],
        "hex": "#8a160d"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 2.7,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.005,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 0.98,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.16,
          "unit": "em"
        }
      }
    },
    "readout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.9,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      }
    }
  }
}
