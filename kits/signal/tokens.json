{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Deep-navy HUD — Chakra Petch headings, mono labels, cyan/blue action, mint and amber status.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.216,
          0.843,
          1
        ],
        "hex": "#37d7ff"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.373,
          0.878,
          1
        ],
        "hex": "#5fe0ff"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.016,
          0.071,
          0.102
        ],
        "hex": "#04121a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.29,
          0.616,
          1
        ],
        "hex": "#4a9dff"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.545,
          0.424,
          1
        ],
        "hex": "#8b6cff"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.02,
          0.027,
          0.051
        ],
        "hex": "#05070d"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.047,
          0.078,
          0.149
        ],
        "hex": "#0c1426"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.106,
          0.196
        ],
        "hex": "#101b32"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.918,
          0.953,
          1
        ],
        "hex": "#eaf3ff"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.557,
          0.639,
          0.769
        ],
        "hex": "#8ea3c4"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.263,
          1,
          0.706
        ],
        "hex": "#43ffb4"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.769,
          0.42
        ],
        "hex": "#ffc46b"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.42,
          0.478
        ],
        "hex": "#ff6b7a"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    }
  }
}
