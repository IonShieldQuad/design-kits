        "hex": "#9c9284"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.071,
          0.063
        ],
        "hex": "#191210"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.561,
          0.682,
          0.373
        ],
        "hex": "#8fae5f"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.796,
          0.447,
          0.4
        ],
        "hex": "#cb7266"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.361,
          0.616,
          0.592
        ],
        "hex": "#5c9d97"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontSize": {
          "value": 2.9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.005,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontSize": {
          "value": 1.32,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow",
        "fontSize": {
          "value": 0.98,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Courier Prime",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    }
  }
}
