        ],
        "hex": "#e0904f"
      }
    },
    "primary-ink-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.643,
          0.408
        ],
        "hex": "#eda468"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.184,
          0.435,
          0.408
        ],
        "hex": "#2f6f68"
      }
    },
