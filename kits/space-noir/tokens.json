          0.078
        ],
        "hex": "#1a1714"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.118,
          0.102,
          0.09
        ],
        "hex": "#1e1a17"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.082,
          0.075,
          0.067
        ],
        "hex": "#151311"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.925,
          0.894,
          0.839
