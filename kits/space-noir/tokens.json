{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "90s space-noir jazz poster — an inked ground, film grain, a halftone screen and one burnt-orange action.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.753,
          0.416,
          0.188
        ],
        "hex": "#c06a30"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.839,
          0.498,
          0.259
        ],
        "hex": "#d67f42"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.878,
