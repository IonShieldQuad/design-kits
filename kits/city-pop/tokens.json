{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A Tokyo bay in daylight — cream sky, coral sun, ocean teal, airbrushed and airy.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.839,
          0.184,
          0.294
        ],
        "hex": "#d62f4b"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.839,
          0.184,
          0.294
        ],
        "hex": "#d62f4b"
      }
    },
    "primary-ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.639,
          0.125,
          0.227
        ],
        "hex": "#a3203a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.604,
          0.659
        ],
        "hex": "#1f9aa8"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.353,
          0.063
        ],
        "hex": "#8a5a10"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.973,
          0.945
        ],
        "hex": "#fff8f1"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.937,
          0.914
        ],
        "hex": "#f6efe9"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.184,
          0.165,
          0.251
        ],
        "hex": "#2f2a40"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.365,
          0.337,
          0.439
        ],
        "hex": "#5d5670"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.471,
          0.31
        ],
        "hex": "#19784f"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.353,
          0.063
        ],
        "hex": "#8a5a10"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.702,
          0.141,
          0.227
        ],
        "hex": "#b3243a"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.173,
          0.408,
          0.769
        ],
        "hex": "#2c68c4"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 5,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Sora",
        "fontSize": {
          "value": 2.85,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Sora",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.005,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    },
    "tech": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.9,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      }
    }
  }
}
