{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Bauhaus geometry on a paper ground — 3px ink rules, hard square corners, and depth expressed as a hard offset shadow with zero blur.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.169,
          0.294,
          0.847
        ],
        "hex": "#2b4bd8"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.122,
          0.224,
          0.702
        ],
        "hex": "#1f39b3"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.282,
          0.184
        ],
        "hex": "#e8482f"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.698,
          0.102
        ],
        "hex": "#f2b21a"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.945,
          0.918
        ],
        "hex": "#f4f1ea"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.992,
          0.969
        ],
        "hex": "#fffdf7"
      }
    },
    "surface-2": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.941,
          0.922,
          0.878
        ],
        "hex": "#f0ebe0"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.067,
          0.059
        ],
        "hex": "#14110f"
      }
    },
    "text-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.306,
          0.275,
          0.247
        ],
        "hex": "#4e463f"
      }
    },
    "text-dim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.42,
          0.384,
          0.353
        ],
        "hex": "#6b625a"
      }
    },
    "ok": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.42,
          0.227
        ],
        "hex": "#1b6b3a"
      }
    },
    "warn": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.325,
          0
        ],
        "hex": "#8a5300"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.702,
          0.149,
          0.118
        ],
        "hex": "#b3261e"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.361,
          0.549
        ],
        "hex": "#0f5c8c"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 2.6,
          "unit": "rem"
        },
        "fontWeight": 900,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 1.7,
          "unit": "rem"
        },
        "fontWeight": 900,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 1.3,
          "unit": "rem"
        },
        "fontWeight": 900
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Archivo",
        "fontSize": {
          "value": 1.05,
          "unit": "rem"
        },
        "fontWeight": 900
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.95,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.8,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Space Mono",
        "fontSize": {
          "value": 0.72,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.1,
          "unit": "em"
        }
      }
    }
